#!/bin/ksh
#
# rc.d script for dns-updater supervised by tower (OpenBSD).
# Copy to /etc/rc.d/dns_updater, then: rcctl enable dns_updater
#
# dns-updater does its own chroot and privilege drop, so tower runs as
# root and the child drops to _dnsupdater itself. It exits 1 on bad
# arguments or a failed sandbox (final, tower stops) and retries provider
# errors internally; anything else that kills it is restarted.
#
# The configuration is an environment directory read by tower (-e), one
# file per variable as with chpst -e, so the token stays out of ps(1):
#   /etc/dns-updater/dns_updater/INTERFACE   vio0
#   /etc/dns-updater/dns_updater/PROVIDER    ipv64
#   /etc/dns-updater/dns_updater/DOMAIN      myhost.example.com
#   /etc/dns-updater/dns_updater/TOKEN       ...           (mode 0600)
#   /etc/dns-updater/dns_updater/IPV6        true
# The directory is read on every start; rcctl restart applies a change.
#
# Several updaters side by side (IPv4 and IPv6, several providers): one
# symlink per instance. The directory is named after the service, so each
# instance has its own configuration and its own command line:
#   ln -s dns_updater /etc/rc.d/dns_updater_v4
#   mkdir /etc/dns-updater/dns_updater_v4
#   rcctl enable dns_updater_v4

daemon="/usr/local/sbin/tower"
daemon_flags="-e /etc/dns-updater/${0##*/} -- /usr/local/bin/dns-updater --chroot /var/empty -u _dnsupdater -g _dnsupdater"
daemon_logger="daemon.info"

. /etc/rc.d/rc.subr

rc_bg=YES
rc_reload=NO

rc_cmd $1
